{
  "version": 2,
  "buildCommand": "npm install -g pnpm --allow-scripts=pnpm && pnpm install --no-frozen-lockfile && pnpm --filter @workspace/ai-workspace build",
  "outputDirectory": "artifacts/ai-workspace/dist/public",
  "installCommand": "npm install -g pnpm --allow-scripts=pnpm",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
