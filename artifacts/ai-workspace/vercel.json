{
  "buildCommand": "cd ../.. && pnpm --filter @workspace/ai-workspace build",
  "outputDirectory": "artifacts/ai-workspace/dist/public",
  "installCommand": "npm install -g pnpm && pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_RAILWAY_URL/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
